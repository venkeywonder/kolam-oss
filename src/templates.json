  {
    "id": "mind", "name": "Mind map", "desc": "A central idea branching into topics.", "color": "#db4c9a",
    "build": [
      { "op": "note", "ref": "center", "x": 360, "y": 220, "w": 240, "color": "pink", "html": "<h1>Central idea</h1>" },
      { "op": "note", "ref": "n0", "x": 0, "y": 0, "w": 220, "html": "<h2>Who is it for?</h2>" },
      { "op": "line", "from": "center", "to": "n0", "arrow": false, "color": "pink" },
      { "op": "note", "ref": "n1", "x": 360, "y": -40, "w": 220, "html": "<h2>Why now?</h2>" },
      { "op": "line", "from": "center", "to": "n1", "arrow": false, "color": "pink" },
      { "op": "note", "ref": "n2", "x": 720, "y": 0, "w": 220, "html": "<h2>How might it work?</h2>" },
      { "op": "line", "from": "center", "to": "n2", "arrow": false, "color": "pink" },
      { "op": "note", "ref": "n3", "x": 740, "y": 420, "w": 220, "html": "<h2>Risks</h2>" },
      { "op": "line", "from": "center", "to": "n3", "arrow": false, "color": "pink" },
      { "op": "note", "ref": "n4", "x": 360, "y": 470, "w": 220, "html": "<h2>What success looks like</h2>" },
      { "op": "line", "from": "center", "to": "n4", "arrow": false, "color": "pink" },
      { "op": "note", "ref": "n5", "x": 0, "y": 420, "w": 220, "html": "<h2>Open questions</h2>" },
      { "op": "line", "from": "center", "to": "n5", "arrow": false, "color": "pink" }
    ]
  },
  {
