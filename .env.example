# Copy to .env (next to server/ and storage/) and adjust. Real environment variables take priority.

# production hides error details; development shows them
APP_ENV=production

# Database. Leave DB_DSN empty to use a SQLite file inside STORAGE_PATH. Tables are created automatically.
# MySQL / MariaDB:
#   DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=kolam;charset=utf8mb4
# PostgreSQL:
#   DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=kolam
DB_DSN=
DB_USER=
DB_PASSWORD=

# Where the SQLite file and uploaded files live (must be writable by PHP, never inside the web root)
STORAGE_PATH=

# Set to false after creating your own account to stop strangers signing up
ALLOW_SIGNUP=true

SESSION_DAYS=30
MAX_UPLOAD_MB=50

# true when PHP sits behind a load balancer / reverse proxy that sets X-Forwarded-For and X-Forwarded-Proto
TRUST_PROXY=false

# Uploaded files: "local" (STORAGE_PATH/assets) or "s3" for DigitalOcean Spaces / any S3-compatible bucket
ASSET_DRIVER=local
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Import boards from the old single-file version (data/state.json) into the first account created
LEGACY_IMPORT=true

# Email sends invitations, and (when EMAIL_VERIFICATION is on) verification and password-reset links. Leave SMTP_HOST
# empty to skip email: each email is then written to storage/mail/ (a placeholder outbox, one .eml file per message) and
# the invite link can be copied from the dialog.
# Resend (verify your domain in Resend first):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_your_api_key
#   SMTP_SECURE=tls
#   MAIL_FROM=notes@example.com
# Generic provider on 587 with STARTTLS:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USER=you@example.com
#   SMTP_PASSWORD=
#   SMTP_SECURE=tls
# Generic provider on 465 with implicit TLS:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=465
#   SMTP_USER=you@example.com
#   SMTP_PASSWORD=
#   SMTP_SECURE=ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls
MAIL_FROM=
MAIL_FROM_NAME=Kolam

# Public URL of the app, used in invitation email links. Leave empty to derive it from the request.
APP_URL=

# Live updates (Phase 2). On a VPS, run the realtime server (bash server/bin/install-realtime.sh), proxy a path to it
# (deploy/nginx.conf, deploy/apache.conf) and set the address browsers use. Leave empty on shared hosting:
# browsers then poll about once a second instead.
#   REALTIME_URL=wss://notes.example.com/ws
REALTIME_URL=
# where server/bin/realtime listens (keep it on 127.0.0.1 behind the proxy)
REALTIME_LISTEN=127.0.0.1:8090

# ---------- Optional switches for running Kolam as a public service (all off by default) ----------

# New accounts must confirm their email before inviting people, making share links or uploading files. Needs SMTP.
EMAIL_VERIFICATION=false
# Refuse sign-ups from throwaway email services (mailinator and the like)
BLOCK_DISPOSABLE_EMAILS=false
# Cloudflare Turnstile bot check on sign-up and "forgot password" (free: dash.cloudflare.com → Turnstile). Empty = off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Days between "delete my account" and the actual deletion; signing in again cancels it
DELETE_GRACE_DAYS=14

# Public website (landing, terms, privacy, help), e.g. https://example.com. The app links to its pages. Empty = no links.
SITE_URL=
SUPPORT_EMAIL=

# Server errors are emailed here
ALERT_EMAIL=

# The operator admin page (account menu → Admin…): users, reports, feedback. Comma-separated emails of
# verified accounts. Empty = no admin page (the server/bin/kolam commands still work).
ADMIN_EMAILS=

# Google Analytics for Firebase in the app (Firebase console → Project settings → Your apps → Web app). Empty = no
# analytics, and the app never contacts Google. Browsers sending Global Privacy Control / Do Not Track aren't tracked.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
