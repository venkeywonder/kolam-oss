#!/usr/bin/env php
<?php
declare(strict_types=1);
// Admin commands. Run from the project folder:  php server/bin/kolam <command>

use Kolam\{Account, Auth, Comments, Db, Config, History, Push, Spaces, Storage\S3Storage, Uploads, YText};

require dirname(__DIR__) . '/bootstrap.php';
if (PHP_SAPI !== 'cli') exit(1);

$cmd = $argv[1] ?? 'help';
$ask = function (string $q, bool $hidden = false): string {
    echo $q;
    if ($hidden && DIRECTORY_SEPARATOR === '/') { system('stty -echo'); $v = trim((string) fgets(STDIN)); system('stty echo'); echo "\n"; return $v; }
    return trim((string) fgets(STDIN));
};

switch ($cmd) {
    case 'migrate':
        Db::pdo();
        echo "Database ready (" . Db::$driver . ")\n";
        break;

    case 'user:create':
        $email = strtolower($argv[2] ?? $ask('Email: '));
        $name = $argv[3] ?? $ask('Name: ');
        $pass = $ask('Password (8+ characters): ', true);
        if (!filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($pass) < 8) exit("Invalid email or password too short\n");
        if (Db::one('SELECT id FROM users WHERE email = ?', [$email])) exit("That email already has an account\n");
        // the same path as signing up (account plus its home workspace); they verify their email from the app's banner
        Auth::createUser($email, $name, password_hash($pass, PASSWORD_DEFAULT), !Config::get('email_verification'), false);
        echo "Created $email\n";
        break;

    case 'user:password':
        $email = strtolower($argv[2] ?? $ask('Email: '));
        $u = Db::one('SELECT id FROM users WHERE email = ?', [$email]) ?? exit("No such user\n");
        $pass = $ask('New password (8+ characters): ', true);
        if (strlen($pass) < 8) exit("Too short\n");
        Db::q('UPDATE users SET pass_hash = ? WHERE id = ?', [password_hash($pass, PASSWORD_DEFAULT), $u['id']]);
        Db::q('DELETE FROM sessions WHERE user_id = ?', [$u['id']]);
        echo "Password changed; all sessions signed out\n";
        break;

    case 'users':
        foreach (Db::q('SELECT email, name, created_at, (SELECT COUNT(*) FROM entities e WHERE e.space_id = u.id AND e.deleted = 0) AS records FROM users u ORDER BY created_at') as $r) {
            printf("%-36s %-24s %s  %d records\n", $r['email'], $r['name'], date('Y-m-d', (int) $r['created_at']), $r['records']);
        }
        break;

    case 'backup':
        Db::pdo();
        if (Db::$driver !== 'sqlite') exit("MySQL/PostgreSQL: use your panel's database backups (aaPanel → Databases → Backup) or mysqldump / pg_dump\n");
        $to = $argv[2] ?? Config::get('storage') . '/backups/kolam-' . date('Ymd-His') . '.sqlite';
        @mkdir(dirname($to), 0775, true);
        Db::pdo()->exec('VACUUM INTO ' . Db::pdo()->quote($to));
        echo "Backed up to $to\n";
        break;

    case 'cleanup':
        $n = Db::q('DELETE FROM sessions WHERE expires_at < ?', [time()])->rowCount();
        $m = Db::q('DELETE FROM entities WHERE deleted = 1 AND updated_at < ?', [time() - 90 * 86400])->rowCount();
        $k = Db::q('DELETE FROM rate_limits WHERE reset_at < ?', [time()])->rowCount();
        $w = Spaces::purgeExpired();
        $i = Db::q("DELETE FROM invites WHERE (status <> 'pending' AND created_at < ?) OR expires_at < ?", [time() - 30 * 86400, time() - 30 * 86400])->rowCount();
        Db::q('DELETE FROM presence WHERE seen_at < ?', [time() - 300]);
        $y = YText::prune();
        $c = Comments::prune();
        $o = Db::q('DELETE FROM notifications WHERE created_at < ?', [(time() - 90 * 86400) * 1000])->rowCount();
        $h = History::prune();
        $a = Account::purgeDue();
        // after sessions and accounts are gone, so their browsers' desktop notifications go too
        $p = Push::prune();
        // uploads nobody finished within 24h: abort and free whatever parts/variants arrived
        $up = Uploads::pruneStale();
        echo "Removed $n expired sessions, $m old deletion markers, $k rate-limit entries, $w deleted workspaces, $i old invitations, "
           . "$y text-log entries of deleted cards, $c comments of deleted cards, $o old notifications, $h history entries, "
           . "$a accounts whose deletion date passed, $p desktop notification subscriptions of signed-out browsers, $up abandoned uploads\n";
        break;

    case 's3-cors':
        // direct browser uploads (S3_DIRECT_UPLOADS=true) need the bucket to allow cross-origin PUT/GET from the app's own origin(s)
        $origins = array_slice($argv, 2);
        if (!$origins) exit("Usage: php server/bin/kolam s3-cors https://notes.example.com [https://other.example.com ...]\n");
        $s3 = Config::get('s3');
        if (!$s3['bucket'] || !$s3['key']) exit("S3_BUCKET / S3_KEY are not set\n");
        $rules = implode('', array_map(fn($o) => '<CORSRule><AllowedOrigin>' . htmlspecialchars($o, ENT_XML1) . '</AllowedOrigin>'
            . '<AllowedMethod>PUT</AllowedMethod><AllowedMethod>GET</AllowedMethod><AllowedMethod>HEAD</AllowedMethod>'
            . '<AllowedHeader>*</AllowedHeader><MaxAgeSeconds>3600</MaxAgeSeconds></CORSRule>', $origins));
        (new S3Storage($s3))->putCors('<CORSConfiguration>' . $rules . '</CORSConfiguration>');
        echo "CORS set on {$s3['bucket']} for: " . implode(', ', $origins) . "\n";
        break;

    case 'reports':
        // reports about share links, newest first; "reports close <id>" marks one handled
        if (($argv[2] ?? '') === 'close' && isset($argv[3])) {
            $n = Db::q("UPDATE reports SET status = 'closed' WHERE id = ?", [$argv[3]])->rowCount();
            exit($n ? "Closed {$argv[3]}\n" : "No such report\n");
        }
        foreach (Db::q("SELECT * FROM reports WHERE status = 'open' ORDER BY created_at DESC") as $r) {
            printf("%s  %s  %-10s link %s  board %s:%s  from %s\n    %s\n", $r['id'], date('Y-m-d H:i', (int) $r['created_at']), $r['reason'],
                $r['share_token'], $r['space_id'], $r['board_id'], $r['email'] ?: $r['ip'], str_replace("\n", "\n    ", (string) $r['details']));
        }
        break;

    case 'feedback':
        // newest 50 messages sent from the app's "Send feedback" dialog
        foreach (Db::q('SELECT * FROM feedback ORDER BY created_at DESC LIMIT 50') as $r) {
            printf("%s  %-9s %-28s %-24s\n    %s\n", date('Y-m-d H:i', (int) $r['created_at']), $r['kind'], $r['email'] ?: '(no email)',
                $r['page'] ?: '', str_replace("\n", "\n    ", (string) $r['body']));
        }
        break;

    default:
        echo <<<TXT
        Kolam admin
          php server/bin/kolam migrate                    create / upgrade database tables
          php server/bin/kolam user:create [email] [name] add an account (works even when sign-ups are closed)
          php server/bin/kolam user:password [email]      reset a password
          php server/bin/kolam users                      list accounts
          php server/bin/kolam backup [file]              copy the SQLite database safely while running
          php server/bin/kolam cleanup                    prune expired sessions, old deletion markers and invitations,
                                                             text logs and comments of deleted cards, notifications and history older
                                                             than 90 days, workspaces deleted more than 30 days ago, accounts
                                                             whose scheduled deletion date has passed, desktop notification
                                                             subscriptions of browsers that signed out, and uploads nobody finished in 24h
          php server/bin/kolam reports [close <id>]       list open reports about share links, or mark one handled
          php server/bin/kolam feedback                   list the newest 50 messages sent from the app
          php server/bin/kolam s3-cors <origin...>        set the bucket's CORS rules for direct browser uploads (S3_DIRECT_UPLOADS=true)

        TXT;
}
